#!/bin/bash
# ==============================================================================
# Token Doctor (token-doctor) v1.1.0
# AI Developer Environment Diagnostic & Token Hygiene CLI
# Dedicated to diagnosing prompt bloat, context rot, rule leaks, and duplicates
# ==============================================================================

set -e

VERSION="1.1.0"

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

TARGET_DIR="$(pwd)"
AUTO_HEAL=false
JSON_MODE=false

# Auto-detect terminal language (en / zh)
DETECTED_LANG="en"
if [[ "${LANG:-}" =~ ^zh ]] || [[ "${LC_ALL:-}" =~ ^zh ]] || [[ "${LC_MESSAGES:-}" =~ ^zh ]]; then
    DETECTED_LANG="zh"
fi
APP_LANG="${TOKEN_DOCTOR_LANG:-$DETECTED_LANG}"

show_help() {
    if [ "$APP_LANG" = "zh" ]; then
        cat << EOF
Token Doctor (token-doctor) v$VERSION
專為 AI 代理環境設計的 Prompt 底噪診斷與治理工具

用法:
  token-doctor [選項] [專案路徑]

選項:
  -f, --heal, --fix    執行自動手術 (隔離代碼標準至 CODING_STANDARDS.md、消除重複、建立工單沙盒)
  --json               以 JSON 格式輸出體檢報告 (適用於 CI/CD 與腳本)
  --lang [en|zh]       指定顯示語系 (預設: 自動偵測終端環境)
  -v, --version        顯示版本號
  -h, --help           顯示說明文件

範例:
  token-doctor                  # 診斷當前目錄
  token-doctor /path/to/project # 診斷指定專案
  token-doctor --heal           # 診斷並直接自動修復當前專案
  token-doctor --lang en        # 以英文介面執行診斷
EOF
    else
        cat << EOF
Token Doctor (token-doctor) v$VERSION
A lightweight diagnostic & auto-healing CLI for AI agent development environments.

Usage:
  token-doctor [options] [project_path]

Options:
  -f, --heal, --fix    Perform auto-healing surgery (isolate standards to CODING_STANDARDS.md, clean duplicates, create sandbox)
  --json               Output diagnostic report in JSON format (ideal for CI/CD)
  --lang [en|zh]       Specify output language (default: auto-detected from locale)
  -v, --version        Show version number
  -h, --help           Show help message

Examples:
  token-doctor                  # Diagnose current directory
  token-doctor /path/to/project # Diagnose specific project
  token-doctor --heal           # Diagnose and auto-heal current project
  token-doctor --lang zh        # Run diagnosis in Traditional Chinese
EOF
    fi
    exit 0
}

# Argument parsing
while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--heal|--fix)
            AUTO_HEAL=true
            shift
            ;;
        --json)
            JSON_MODE=true
            shift
            ;;
        --lang)
            if [ -n "$2" ] && [[ "$2" =~ ^(en|zh)$ ]]; then
                APP_LANG="$2"
                shift 2
            else
                echo -e "${RED}Error: --lang requires 'en' or 'zh'${NC}" >&2
                exit 1
            fi
            ;;
        -v|--version)
            echo "token-doctor v$VERSION"
            exit 0
            ;;
        -h|--help)
            show_help
            ;;
        *)
            if [ -d "$1" ]; then
                TARGET_DIR="$1"
            else
                if [ "$APP_LANG" = "zh" ]; then
                    echo -e "${RED}錯誤: 路徑不存在 [$1]${NC}" >&2
                else
                    echo -e "${RED}Error: Path does not exist [$1]${NC}" >&2
                fi
                exit 1
            fi
            shift
            ;;
    esac
done

cd "$TARGET_DIR"
PROJECT_NAME="$(basename "$TARGET_DIR")"

# ------------------------------------------------------------------------------
# Diagnostic checks and metric calculation
# ------------------------------------------------------------------------------

SCORE=100
SYMPTOMS=()
HEAL_ACTIONS=()

# 1. Check double loading (GEMINI.md + AGENTS.md)
HAS_GEMINI=false
HAS_AGENTS=false
GEMINI_LINES=0
AGENTS_LINES=0
AGENTS_CHARS=0

[ -f "GEMINI.md" ] && HAS_GEMINI=true && GEMINI_LINES=$(wc -l < GEMINI.md | tr -d ' ')
[ -f "AGENTS.md" ] && HAS_AGENTS=true && AGENTS_LINES=$(wc -l < AGENTS.md | tr -d ' ') && AGENTS_CHARS=$(wc -m < AGENTS.md | tr -d ' ')

if [ "$HAS_GEMINI" = true ] && [ "$HAS_AGENTS" = true ]; then
    SCORE=$((SCORE - 20))
    if [ "$APP_LANG" = "zh" ]; then
        SYMPTOMS+=("🚨 [雙重載入風險] 專案根目錄同時存在 AGENTS.md 與 GEMINI.md，IDE 每次對話雙重注入！(扣 20 分)")
        HEAL_ACTIONS+=("備份並移除 GEMINI.md (重命名為 GEMINI.md.bak)")
    else
        SYMPTOMS+=("🚨 [Duplicate Root Files] Both AGENTS.md and GEMINI.md exist; AI context suffers from double injection! (-20 pts)")
        HEAL_ACTIONS+=("Backup and deactivate GEMINI.md (rename to GEMINI.md.bak)")
    fi
elif [ "$HAS_GEMINI" = true ]; then
    if [ "$APP_LANG" = "zh" ]; then
        SYMPTOMS+=("ℹ️  [命名建議] 專案使用 GEMINI.md，建議遵循開源標準統一為 AGENTS.md。")
    else
        SYMPTOMS+=("ℹ️  [Naming Pointer] Project uses GEMINI.md; recommend standardizing to AGENTS.md.")
    fi
fi

# 2. Check AGENTS.md size & code standard spillover
if [ "$HAS_AGENTS" = true ]; then
    # Detect code-level standards (e.g., line limits, CSS/styling rules, lazy loading, naming rules)
    if grep -E -n "行內|行數|React.lazy|單檔.*行|命名規範|CSS|SCSS|border-|leading-|max-lines|component-size" AGENTS.md > /dev/null 2>&1; then
        SCORE=$((SCORE - 15))
        MATCH_LINES=$(grep -E -n "行內|行數|React.lazy|單檔.*行|命名規範|CSS|SCSS|border-|leading-|max-lines|component-size" AGENTS.md | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')
        if [ "$APP_LANG" = "zh" ]; then
            SYMPTOMS+=("🚨 [代碼標準外溢] AGENTS.md (第 $MATCH_LINES 行) 混入組件行數、樣式或框架調用規範！(扣 15 分)")
            HEAL_ACTIONS+=("將代碼與樣式規範安全剪下，移植至 CODING_STANDARDS.md")
        else
            SYMPTOMS+=("🚨 [Code Standard Spillover] AGENTS.md (lines $MATCH_LINES) leaks styling, framework, or line-count rules! (-15 pts)")
            HEAL_ACTIONS+=("Isolate coding & styling rules into CODING_STANDARDS.md")
        fi
    fi

    # Detect duplicate global rules
    if grep -E -n "Conventional Commits|繁體中文|CLI/API/curl" AGENTS.md > /dev/null 2>&1; then
        SCORE=$((SCORE - 10))
        MATCH_LINES=$(grep -E -n "Conventional Commits|繁體中文|CLI/API/curl" AGENTS.md | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')
        if [ "$APP_LANG" = "zh" ]; then
            SYMPTOMS+=("⚠️  [全域規則重複] AGENTS.md (第 $MATCH_LINES 行) 重複宣告全局已有指令 (如 Conventional Commits)。(扣 10 分)")
            HEAL_ACTIONS+=("刪除 AGENTS.md 內重複的全域指令")
        else
            SYMPTOMS+=("⚠️  [Redundant Global Directives] AGENTS.md (lines $MATCH_LINES) repeats directives already handled globally. (-10 pts)")
            HEAL_ACTIONS+=("Clean up redundant global directives from AGENTS.md")
        fi
    fi

    # Check line count
    if [ "$AGENTS_LINES" -gt 60 ]; then
        SCORE=$((SCORE - 15))
        if [ "$APP_LANG" = "zh" ]; then
            SYMPTOMS+=("⚠️  [文檔體積過重] AGENTS.md 高達 $AGENTS_LINES 行，已偏離 20~30 行純粹業務指針的標準。(扣 15 分)")
        else
            SYMPTOMS+=("⚠️  [Bloated Context] AGENTS.md is $AGENTS_LINES lines, exceeding the recommended 20-30 line context pointer. (-15 pts)")
        fi
    elif [ "$AGENTS_LINES" -gt 40 ]; then
        SCORE=$((SCORE - 5))
        if [ "$APP_LANG" = "zh" ]; then
            SYMPTOMS+=("ℹ️  [文檔體積略高] AGENTS.md 目前 $AGENTS_LINES 行，有精簡為極簡指針的潛力。(扣 5 分)")
        else
            SYMPTOMS+=("ℹ️  [Slightly Heavy] AGENTS.md is $AGENTS_LINES lines; can be condensed further. (-5 pts)")
        fi
    fi
else
    SCORE=$((SCORE - 15))
    if [ "$APP_LANG" = "zh" ]; then
        SYMPTOMS+=("⚠️  [缺乏導航地圖] 專案缺乏 AGENTS.md，AI 進入專案缺乏上下文錨定！(扣 15 分)")
        HEAL_ACTIONS+=("建立標準極簡 AGENTS.md 專案導航地圖")
    else
        SYMPTOMS+=("⚠️  [Missing Navigation Map] No AGENTS.md found; AI agents lack architectural anchoring! (-15 pts)")
        HEAL_ACTIONS+=("Create clean, minimal AGENTS.md navigation map")
    fi
fi

# 3. Check CODING_STANDARDS.md existence
HAS_STANDARDS=false
[ -f "CODING_STANDARDS.md" ] && HAS_STANDARDS=true

if [ "$HAS_STANDARDS" = false ]; then
    SCORE=$((SCORE - 10))
    if [ "$APP_LANG" = "zh" ]; then
        SYMPTOMS+=("⚠️  [缺乏審查防線] 專案無 CODING_STANDARDS.md，代碼審查時無深模組與壞味道檢驗標準。(扣 10 分)")
        HEAL_ACTIONS+=("建立 CODING_STANDARDS.md (含 Martin Fowler 12 大壞味道防線)")
    else
        SYMPTOMS+=("⚠️  [Missing Review Gate] No CODING_STANDARDS.md found for Reviewer context isolation. (-10 pts)")
        HEAL_ACTIONS+=("Initialize CODING_STANDARDS.md (with Martin Fowler 12 Code Smells defense)")
    fi
fi

# 4. Check .scratch sandbox
HAS_SCRATCH=false
[ -d ".scratch" ] && HAS_SCRATCH=true

if [ "$HAS_SCRATCH" = false ]; then
    SCORE=$((SCORE - 10))
    if [ "$APP_LANG" = "zh" ]; then
        SYMPTOMS+=("⚠️  [缺乏工單沙盒] 專案無 .scratch/ 目錄，工單與特徵規格書可能污染主倉庫！(扣 10 分)")
        HEAL_ACTIONS+=("建立 .scratch/ 沙盒目錄並注入 .gitignore")
    else
        SYMPTOMS+=("⚠️  [Missing Ticket Sandbox] No .scratch/ directory found; temporary specs may pollute git tree! (-10 pts)")
        HEAL_ACTIONS+=("Create .scratch/ sandbox directory with .gitignore")
    fi
fi

# 5. Global Skills and MCP tool load probing
GLOBAL_AUTO_SKILLS=0
if [ -d "$HOME/.gemini/config/plugins" ]; then
    GLOBAL_AUTO_SKILLS=$(grep -r -L "disable-model-invocation: true" "$HOME/.gemini/config/plugins" 2>/dev/null | grep "/SKILL.md" | wc -l | tr -d ' ' || echo 0)
fi
if [ -d "$HOME/.gemini/config/skills" ]; then
    LOOSE_SKILLS=$(find "$HOME/.gemini/config/skills" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ' || echo 0)
    GLOBAL_AUTO_SKILLS=$((GLOBAL_AUTO_SKILLS + LOOSE_SKILLS))
fi

MCP_TOOLS_COUNT=0
if [ -f "$HOME/.gemini/config/mcp_config.json" ]; then
    MCP_SERVERS=$(grep -o '"[^"]*": {' "$HOME/.gemini/config/mcp_config.json" 2>/dev/null | wc -l | tr -d ' ' || echo 0)
    MCP_TOOLS_COUNT=$((MCP_SERVERS * 8))
fi

# Base token estimation
EST_BASE_TOKENS=500
EST_BASE_TOKENS=$((EST_BASE_TOKENS + (AGENTS_CHARS / 2)))
EST_BASE_TOKENS=$((EST_BASE_TOKENS + (GEMINI_LINES * 10)))
EST_BASE_TOKENS=$((EST_BASE_TOKENS + (GLOBAL_AUTO_SKILLS * 60)))
EST_BASE_TOKENS=$((EST_BASE_TOKENS + (MCP_TOOLS_COUNT * 25)))

[ $SCORE -lt 0 ] && SCORE=0

# ------------------------------------------------------------------------------
# JSON Output Mode
# ------------------------------------------------------------------------------
if [ "$JSON_MODE" = true ]; then
    cat << EOF
{
  "project": "$PROJECT_NAME",
  "score": $SCORE,
  "estimatedBaseTokens": $EST_BASE_TOKENS,
  "agentsLines": $AGENTS_LINES,
  "hasDuplicateGemini": $HAS_GEMINI,
  "hasCodingStandards": $HAS_STANDARDS,
  "hasScratchSandbox": $HAS_SCRATCH,
  "symptomsCount": ${#SYMPTOMS[@]}
}
EOF
    exit 0
fi

# ------------------------------------------------------------------------------
# Terminal Human-Readable Output
# ------------------------------------------------------------------------------
echo -e "${BOLD}================================================================${NC}"
if [ "$APP_LANG" = "zh" ]; then
    echo -e "${CYAN}🩺 Token 健檢醫生 - 專案健康診斷報告${NC}"
    echo -e "📂 專案名稱: ${BOLD}$PROJECT_NAME${NC} (${TARGET_DIR})"
else
    echo -e "${CYAN}🩺 Token Doctor - Workspace Health Report${NC}"
    echo -e "📂 Project: ${BOLD}$PROJECT_NAME${NC} (${TARGET_DIR})"
fi
echo -e "${BOLD}================================================================${NC}"

# Score and status
SCORE_COLOR=$GREEN
if [ "$APP_LANG" = "zh" ]; then
    STATUS_TEXT="健康純淨 (Lean & Clean)"
    if [ $SCORE -lt 70 ]; then
        SCORE_COLOR=$RED
        STATUS_TEXT="嚴重肥胖 (Severe Context Rot)"
    elif [ $SCORE -lt 85 ]; then
        SCORE_COLOR=$YELLOW
        STATUS_TEXT="輕度超重 (Minor Spillover)"
    fi
    echo -e "📊 健康綜合評分: ${SCORE_COLOR}${BOLD}$SCORE / 100${NC} [${SCORE_COLOR}$STATUS_TEXT${NC}]"
    echo -e "⚡ 預估每輪對話靜態底噪: ${BOLD}~$EST_BASE_TOKENS Tokens${NC} (建議目標: < 1,200 Tokens)"
    echo ""
    echo -e "${BOLD}【🔍 病灶盤點與診斷清單】${NC}"
    echo "----------------------------------------------------------------"
    if [ ${#SYMPTOMS[@]} -eq 0 ]; then
        echo -e "${GREEN}🎉 完美無瑕！該專案未偵測到任何 Token 洩漏或規範隔離外溢病灶。${NC}"
    else
        for s in "${SYMPTOMS[@]}"; do
            if [[ "$s" == 🚨* ]]; then
                echo -e "${RED}$s${NC}"
            elif [[ "$s" == ⚠️* ]]; then
                echo -e "${YELLOW}$s${NC}"
            else
                echo -e "${BLUE}$s${NC}"
            fi
        done
    fi
else
    STATUS_TEXT="Lean & Clean"
    if [ $SCORE -lt 70 ]; then
        SCORE_COLOR=$RED
        STATUS_TEXT="Severe Context Rot"
    elif [ $SCORE -lt 85 ]; then
        SCORE_COLOR=$YELLOW
        STATUS_TEXT="Minor Spillover"
    fi
    echo -e "📊 Health Score: ${SCORE_COLOR}${BOLD}$SCORE / 100${NC} [${SCORE_COLOR}$STATUS_TEXT${NC}]"
    echo -e "⚡ Estimated Prompt Noise: ${BOLD}~$EST_BASE_TOKENS Tokens / turn${NC} (Target: < 1,200 Tokens)"
    echo ""
    echo -e "${BOLD}[🔍 Diagnostic Findings & Symptoms]${NC}"
    echo "----------------------------------------------------------------"
    if [ ${#SYMPTOMS[@]} -eq 0 ]; then
        echo -e "${GREEN}🎉 Flawless! No token leaks, rule duplicates, or spillover detected.${NC}"
    else
        for s in "${SYMPTOMS[@]}"; do
            if [[ "$s" == 🚨* ]]; then
                echo -e "${RED}$s${NC}"
            elif [[ "$s" == ⚠️* ]]; then
                echo -e "${YELLOW}$s${NC}"
            else
                echo -e "${BLUE}$s${NC}"
            fi
        done
    fi
fi

echo "----------------------------------------------------------------"

# ------------------------------------------------------------------------------
# Auto-Heal Execution
# ------------------------------------------------------------------------------
if [ "$AUTO_HEAL" = true ]; then
    echo ""
    if [ "$APP_LANG" = "zh" ]; then
        echo -e "${BOLD}💊 【醫生正在執行手術處方 (Auto-Heal)...】${NC}"
    else
        echo -e "${BOLD}💊 [Doctor Performing Surgery (Auto-Heal)...]${NC}"
    fi
    echo "----------------------------------------------------------------"

    # 1. Create .scratch sandbox
    if [ "$HAS_SCRATCH" = false ]; then
        mkdir -p .scratch
        echo "*" > .scratch/.gitignore
        if [ "$APP_LANG" = "zh" ]; then
            echo -e "${GREEN}✅ [手術 1/4] 已建立工單沙盒 .scratch/ (配置 .gitignore)${NC}"
        else
            echo -e "${GREEN}✅ [Surgery 1/4] Created ticket sandbox .scratch/ (with .gitignore)${NC}"
        fi
    fi

    # 2. Backup conflicting GEMINI.md
    if [ "$HAS_GEMINI" = true ] && [ "$HAS_AGENTS" = true ]; then
        mv GEMINI.md GEMINI.md.bak
        if [ "$APP_LANG" = "zh" ]; then
            echo -e "${GREEN}✅ [手術 2/4] 已將衝突的 GEMINI.md 備份為 GEMINI.md.bak 阻斷雙重載入${NC}"
        else
            echo -e "${GREEN}✅ [Surgery 2/4] Backed up conflicting GEMINI.md to GEMINI.md.bak to stop double injection${NC}"
        fi
    fi

    # 3. Create CODING_STANDARDS.md if missing
    if [ "$HAS_STANDARDS" = false ]; then
        if [ "$APP_LANG" = "zh" ]; then
            cat << 'EOF' > CODING_STANDARDS.md
# CODING_STANDARDS.md

> **Token 門禁宣告**：本文件**僅供 Reviewer (審查 Agent) 在獨立 Context 載入**。實作 Agent (Implementer) 嚴禁預載本文件，專注於 Spec 驗收與 TDD (Red ➔ Green)。

---

## 1. 架構原則 (Architectural Integrity)
- **深模組設計 (Deep Modules)**：介面極簡、實作深厚。杜絕穿透型 (Pass-through) 淺模組。
- **測試接縫 (Seams)**：僅在公開介面/API 進行外部行為測試，嚴禁對私有內部細節寫測試。
- **資訊隱藏 (Information Hiding)**：狀態與複雜邏輯封裝於模組內部，對外暴露最少概念。

---

## 2. 代碼壞味道防線 (Martin Fowler 12 Smells)
審查 Agent 發現以下壞味道時，**必須直接自動重構修復**：
1. **神秘命名 (Mysterious Name)**：變數、函式未能清晰表述意圖。
2. **重複代碼 (Duplicated Code)**：相同邏輯出現在多處。
3. **過長函式 (Long Function)**：單一函式職責過多，超過 40 行應考慮提煉。
4. **發散式變化 (Divergent Change)**：單一模組因不同原因被反覆修改。
5. **散彈式修改 (Shotgun Surgery)**：修改一處需求需同時動到多個檔案。
6. **依戀情節 (Feature Envy)**：某函式對另一個物件的資料互動頻率高於自身。
7. **資料泥團 (Data Clumps)**：總是一起出現的多個參數，應提煉為物件。
8. **基本型別偏執 (Primitive Obsession)**：拒絕建立小型領域型別，全用 string/number。
9. **反覆的 switch/if (Repeated Switches)**：應以多型或狀態表取代。
10. **冗員元素 (Lazy Element)**：無實質意義的透傳型類別或包裝函式。
11. **誇誇其談未來性 (Speculative Generality)**：為不存在的需求預留抽象。
12. **註解遮羞布 (Comments as Deodorant)**：用註解解釋糟糕代碼，應直接重構代碼本身。

---

## 3. 本專案特化代碼標準 (Project Standards)
EOF
            echo -e "${GREEN}✅ [手術 3/4] 已建立標準 CODING_STANDARDS.md 審查防線${NC}"
        else
            cat << 'EOF' > CODING_STANDARDS.md
# CODING_STANDARDS.md

> **Token Gate Declaration**: This file is **strictly loaded by the Reviewer Agent in a fresh context**. The Implementer agent must NEVER preload this file; focus on Spec acceptance and TDD (Red ➔ Green).

---

## 1. Architectural Integrity
- **Deep Modules**: Simple interfaces hiding deep implementations. Eliminate shallow pass-through abstractions.
- **Seams**: Test externally against public interfaces/APIs; never test private implementation details.
- **Information Hiding**: State and complex logic encapsulated internally, exposing minimal cognitive load.

---

## 2. Code Smells Defense (Martin Fowler 12 Smells)
When the Reviewer agent detects any of the following code smells, **refactor and commit automatically**:
1. **Mysterious Name**: Unclear variables, functions, or classes.
2. **Duplicated Code**: Identical or near-identical logic repeated across files.
3. **Long Function**: Functions doing too much; decompose if >40 lines.
4. **Divergent Change**: A module altered for unrelated business reasons.
5. **Shotgun Surgery**: One change requires multiple small edits across disparate files.
6. **Feature Envy**: A function accessing another object's fields more than its own.
7. **Data Clumps**: Parameters constantly passed together; encapsulate into objects.
8. **Primitive Obsession**: Reluctance to create domain types instead of primitive strings/numbers.
9. **Repeated Switches**: Polymorphism or lookup tables preferred over deep nested branches.
10. **Lazy Element**: Pass-through wrappers or classes that add zero value.
11. **Speculative Generality**: Over-engineering for hypothetical future requirements.
12. **Comments as Deodorant**: Comments explaining bad code; refactor the code instead.

---

## 3. Project-Specific Standards
EOF
            echo -e "${GREEN}✅ [Surgery 3/4] Created CODING_STANDARDS.md review gate${NC}"
        fi
    fi

    # 4. Append or create clean AGENTS.md navigation pointer
    HOOK_MARKER="Context Map"
    if [ "$HAS_AGENTS" = true ]; then
        if ! grep -q "$HOOK_MARKER" AGENTS.md; then
            if [ "$APP_LANG" = "zh" ]; then
                cat << 'EOF' >> AGENTS.md

---

## 專案導航地圖 (Context Map)
- **規格與工單**: `.scratch/<feature-slug>/` (spec.md 與 tracer bullet 工單)
- **代碼標準**: [CODING_STANDARDS.md](CODING_STANDARDS.md)（僅供 Reviewer 審查讀取，實作嚴禁預載）
- **核心入口**: 遵循規格驅動與 TDD 開發管線
EOF
                echo -e "${GREEN}✅ [手術 4/4] 已在現有 AGENTS.md 尾端追加極簡導航地圖${NC}"
            else
                cat << 'EOF' >> AGENTS.md

---

## Workspace Context Map
- **Specs & Tickets**: `.scratch/<feature-slug>/` (spec.md and tracer-bullet tickets)
- **Coding Standards**: [CODING_STANDARDS.md](CODING_STANDARDS.md) (strictly for Reviewer; never preload in Implementer)
- **Core Workflow**: Spec-driven development & TDD loop
EOF
                echo -e "${GREEN}✅ [Surgery 4/4] Appended minimal Context Map to AGENTS.md${NC}"
            fi
        else
            if [ "$APP_LANG" = "zh" ]; then
                echo -e "ℹ️  [手術 4/4] AGENTS.md 已包含導航地圖，略過追加。"
            else
                echo -e "ℹ️  [Surgery 4/4] AGENTS.md already contains Context Map; skipped."
            fi
        fi
    else
        if [ "$APP_LANG" = "zh" ]; then
            cat << 'EOF' > AGENTS.md
# AGENTS.md

## 專案導航地圖 (Context Map)
- **規格與工單**: `.scratch/<feature-slug>/`
- **架構決策 (ADR)**: docs/adr/
- **領域名詞 (Glossary)**: GLOSSARY.md
- **代碼標準**: [CODING_STANDARDS.md](CODING_STANDARDS.md)（僅供 Reviewer 讀取，實作 Agent 嚴禁預載）
EOF
            echo -e "${GREEN}✅ [手術 4/4] 已為專案建立極簡 AGENTS.md 導航地圖${NC}"
        else
            cat << 'EOF' > AGENTS.md
# AGENTS.md

## Workspace Context Map
- **Specs & Tickets**: `.scratch/<feature-slug>/`
- **Architecture Decisions (ADR)**: docs/adr/
- **Domain Glossary**: GLOSSARY.md
- **Coding Standards**: [CODING_STANDARDS.md](CODING_STANDARDS.md) (loaded strictly by Reviewer; isolated from Implementer)
EOF
            echo -e "${GREEN}✅ [Surgery 4/4] Initialized clean AGENTS.md context map${NC}"
        fi
    fi

    echo "--------------------------------------------------------"
    if [ "$APP_LANG" = "zh" ]; then
        echo -e "${GREEN}${BOLD}🎉 手術修復完成！重新測量健康指數中...${NC}"
    else
        echo -e "${GREEN}${BOLD}🎉 Surgery completed! Re-assessing workspace health...${NC}"
    fi
    exec "$0" "$TARGET_DIR" --lang "$APP_LANG"
else
    if [ ${#HEAL_ACTIONS[@]} -gt 0 ]; then
        if [ "$APP_LANG" = "zh" ]; then
            echo -e "${BOLD}💊 【醫生處方箋 (Recommendations)】${NC}"
            for h in "${HEAL_ACTIONS[@]}"; do
                echo -e "  • $h"
            done
            echo ""
            echo -e "👉 想要自動完成上述修復？請在終端機執行："
            echo -e "   ${CYAN}${BOLD}token-doctor --heal${NC}"
            echo ""
        else
            echo -e "${BOLD}💊 [Doctor Recommendations]${NC}"
            for h in "${HEAL_ACTIONS[@]}"; do
                echo -e "  • $h"
            done
            echo ""
            echo -e "👉 To automatically heal all issues, run in your terminal:"
            echo -e "   ${CYAN}${BOLD}token-doctor --heal${NC}"
            echo ""
        fi
    fi
fi

echo -e "${BOLD}================================================================${NC}"
